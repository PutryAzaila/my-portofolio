---
const certs = [
  { title: "Certificate of Competency - Node & React JS", issuer: "DOT", year: "2023", icon: "fa-solid fa-award",    grad: "from-violet-500 to-rose-500", bar: "from-violet-500 to-rose-500", link: "https://drive.google.com/file/d/1fq-SLHcQBPBVk5UHE6H9G0HjSg2s4XNf/view?usp=sharing" },
  { title: "MTA JavaScript",         issuer: "Microsoft Technology Associate", year: "2023", icon: "fa-brands fa-microsoft", grad: "from-teal-500 to-violet-500",   bar: "from-teal-500 to-violet-500",   link: "https://drive.google.com/file/d/1NHe9jJ-0zejlcw3hKkEku-axZvVR1dvy/view?usp=sharing" },
  { title: "Junior UI/UX Designer",  issuer: "BNSP", year: "2023", icon: "fa-solid fa-palette",   grad: "from-rose-500 to-violet-500",  bar: "from-rose-500 to-violet-500",  link: "https://drive.google.com/file/d/17Gbgdtlu83pW8KnVAms2bLeco_-SW65J/view?usp=sharing" },
  { title: "Junior Graphic Designer",issuer: "BNSP", year: "2022", icon: "fa-solid fa-pen-nib",   grad: "from-violet-500 to-teal-500",  bar: "from-violet-500 to-teal-500",  link: "https://drive.google.com/file/d/1AruXdaNT9ym2E021w9wefgmtZV9g00tk/view?usp=sharing" },
];
---

<section id="certificates" class="py-24 px-6 bg-slate-50 dark:bg-slate-950 relative overflow-hidden">
  <div class="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-violet-400/60 to-transparent"></div>

  <div class="container mx-auto max-w-6xl">
    <div class="text-center mb-16 animate-on-scroll">
      <div class="section-badge bg-violet-50 dark:bg-violet-500/20 border-violet-200 dark:border-violet-500/40 text-violet-600 dark:text-violet-300 mb-4 mx-auto" style="width:fit-content;">
        <i class="fa-solid fa-certificate"></i> Achievements
      </div>
      <h2 class="text-4xl md:text-5xl font-black text-slate-900 dark:text-white mb-4">
        Certificates &amp; <span class="bg-gradient-to-r from-violet-500 to-teal-500 text-transparent bg-clip-text">Awards</span>
      </h2>
      <div class="w-20 h-1 bg-gradient-to-r from-violet-500 to-teal-500 mx-auto rounded-full"></div>
    </div>

    <div class="grid sm:grid-cols-2 gap-6">
      {certs.map((cert, i) => (
        <div class="group bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 hover:border-slate-300 dark:hover:border-slate-600 transition-all duration-300 card-hover overflow-hidden animate-on-scroll" style={`transition-delay:${i*0.1}s`}>
          <div class={`h-1 w-full bg-gradient-to-r ${cert.bar}`}></div>
          <div class="p-6 flex items-start gap-4">
            <div class={`w-12 h-12 bg-gradient-to-br ${cert.grad} rounded-2xl flex items-center justify-center flex-shrink-0 shadow-md group-hover:scale-110 group-hover:rotate-6 transition-all duration-300`}>
              <i class={`${cert.icon} text-white text-xl`}></i>
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-start justify-between gap-2 mb-1">
                <h3 class="text-sm font-bold text-slate-900 dark:text-white leading-tight">{cert.title}</h3>
                <span class="text-xs text-slate-400 dark:text-slate-500 bg-slate-100 dark:bg-slate-700 px-2 py-0.5 rounded-full flex-shrink-0">{cert.year}</span>
              </div>
              <p class="text-xs text-slate-500 dark:text-slate-400 mb-4">{cert.issuer}</p>
              <a href={cert.link} target="_blank" rel="noopener noreferrer"
                class={`inline-flex items-center gap-2 px-4 py-2 bg-gradient-to-r ${cert.grad} text-white text-xs font-semibold rounded-full shadow hover:shadow-md hover:scale-105 transition-all duration-300`}>
                <i class="fa-solid fa-eye"></i>
                View Certificate
                <i class="fa-solid fa-arrow-up-right-from-square text-xs"></i>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

    <div class="text-center mt-10 animate-on-scroll">
      <span class="inline-flex items-center gap-1.5 text-slate-400 dark:text-slate-500 text-xs">
        <i class="fa-solid fa-star text-violet-500"></i>
        <i class="fa-solid fa-star text-violet-500"></i>
        <i class="fa-solid fa-star text-violet-500"></i>
        <i class="fa-solid fa-star text-violet-500"></i>
        <span class="ml-1">4 professional certifications earned</span>
      </span>
    </div>
  </div>
</section>
