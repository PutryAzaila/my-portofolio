<header class="fixed top-0 left-0 right-0 z-50 px-4 sm:px-6 pt-4 transition-all duration-500" id="main-header">
  <div class="max-w-5xl mx-auto dark:bg-slate-900/80 bg-white/85 backdrop-blur-2xl rounded-full shadow-lg dark:border-slate-700/50 border-slate-200 border px-5 lg:px-7 transition-all duration-300" id="header-inner">
    <div class="flex justify-between items-center h-14">

      <!-- Brand name only -->
      <a href="#" class="font-bold text-sm bg-gradient-to-r from-rose-400 to-violet-400 text-transparent bg-clip-text">
        Azaila Putri
      </a>

      <!-- Desktop nav -->
      <nav class="hidden lg:flex items-center gap-0.5">
        {[
          ['#about','About'],['#skills','Skills'],['#experience','Experience'],
          ['#education','Education'],['#certificates','Certs'],['#projects','Projects'],
        ].map(([href, label]) => (
          <a href={href}
            class="nav-link px-3 py-1.5 rounded-full text-sm font-medium dark:text-slate-300 text-slate-600 dark:hover:text-white hover:text-slate-900 dark:hover:bg-white/10 hover:bg-slate-100 transition-all duration-200">
            {label}
          </a>
        ))}
      </nav>

      <!-- Right: Contact + theme toggle + hamburger -->
      <div class="flex items-center gap-2">
        <a href="mailto:putryazaila1306@gmail.com"
          class="hidden sm:flex items-center gap-1.5 px-4 py-2 rounded-full bg-gradient-to-r from-rose-500 to-violet-500 hover:from-rose-600 hover:to-violet-600 text-white font-semibold text-sm shadow hover:shadow-rose-500/30 transition-all duration-300 hover:scale-105">
          <i class="fa-solid fa-envelope text-xs"></i>
          <span class="hidden md:inline">Contact</span>
        </a>

        <!-- Theme toggle — onclick inline, paling reliable -->
        <button onclick="toggleTheme()"
          class="w-8 h-8 rounded-full dark:bg-slate-800 bg-slate-100 dark:hover:bg-slate-700 hover:bg-slate-200 dark:border-slate-600/50 border-slate-300 border flex items-center justify-center transition-all duration-200 hover:scale-110"
          aria-label="Toggle theme">
          <i class="theme-moon fa-solid fa-moon text-slate-500 text-xs"></i>
          <i class="theme-sun fa-solid fa-sun text-amber-400 text-xs"></i>
        </button>

        <!-- Hamburger -->
        <button id="hamburgerBtn"
          class="lg:hidden w-8 h-8 rounded-full dark:bg-slate-800 bg-slate-100 dark:hover:bg-slate-700 hover:bg-slate-200 dark:border-slate-600/50 border-slate-300 border flex flex-col items-center justify-center gap-[5px] transition-all duration-200"
          aria-label="Toggle menu" aria-expanded="false">
          <span class="bar block w-4 h-[2px] dark:bg-slate-300 bg-slate-600 rounded-full transition-all duration-300"></span>
          <span class="bar block w-4 h-[2px] dark:bg-slate-300 bg-slate-600 rounded-full transition-all duration-300"></span>
          <span class="bar block w-4 h-[2px] dark:bg-slate-300 bg-slate-600 rounded-full transition-all duration-300"></span>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile menu — centered dropdown -->
  <div id="mobileMenu"
    class="lg:hidden absolute left-4 right-4 top-[72px] dark:bg-slate-900/95 bg-white/95 backdrop-blur-2xl rounded-2xl dark:border-slate-700/60 border-slate-200 border shadow-2xl overflow-hidden"
    style="opacity:0; transform:translateY(-8px) scale(0.97); pointer-events:none; transition: opacity 0.22s ease, transform 0.22s ease;">

    <nav class="flex flex-col items-center py-5 px-4 gap-1">
      {[
        ['#about','fa-solid fa-user','About'],
        ['#skills','fa-solid fa-code','Skills'],
        ['#experience','fa-solid fa-briefcase','Experience'],
        ['#education','fa-solid fa-graduation-cap','Education'],
        ['#certificates','fa-solid fa-certificate','Certificates'],
        ['#projects','fa-solid fa-laptop-code','Projects'],
        ['#contributions','fa-solid fa-chart-line','Contributions'],
      ].map(([href, icon, label]) => (
        <a href={href}
          class="mobile-nav-link w-full max-w-xs flex items-center justify-center gap-3 px-5 py-3 rounded-xl text-sm font-semibold dark:text-slate-300 text-slate-700 dark:hover:text-white hover:text-slate-900 dark:hover:bg-white/8 hover:bg-slate-100 transition-all duration-200">
          <i class={`${icon} w-4 text-center text-rose-400`}></i>
          {label}
        </a>
      ))}
    </nav>

    <div class="px-6 pb-5 pt-1 border-t dark:border-slate-700/60 border-slate-100">
      <a href="mailto:putryazaila1306@gmail.com"
        class="mobile-nav-link flex items-center justify-center gap-2 w-full py-3 rounded-xl bg-gradient-to-r from-rose-500 to-violet-500 hover:from-rose-600 hover:to-violet-600 text-white font-semibold text-sm shadow hover:shadow-rose-500/30 transition-all duration-300">
        <i class="fa-solid fa-envelope"></i>
        Contact Me
      </a>
    </div>
  </div>
</header>

<script>
  const hamburger  = document.getElementById('hamburgerBtn');
  const mobileMenu = document.getElementById('mobileMenu') as HTMLElement | null;
  const bars       = document.querySelectorAll('#hamburgerBtn .bar');
  let isOpen = false;

  function openMenu() {
    isOpen = true;
    if (!mobileMenu) return;
    mobileMenu.style.opacity       = '1';
    mobileMenu.style.transform     = 'translateY(0) scale(1)';
    mobileMenu.style.pointerEvents = 'auto';
    hamburger?.setAttribute('aria-expanded', 'true');
    (bars[0] as HTMLElement).style.transform = 'rotate(45deg) translateY(7px)';
    (bars[1] as HTMLElement).style.opacity   = '0';
    (bars[2] as HTMLElement).style.transform = 'rotate(-45deg) translateY(-7px)';
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    isOpen = false;
    if (!mobileMenu) return;
    mobileMenu.style.opacity       = '0';
    mobileMenu.style.transform     = 'translateY(-8px) scale(0.97)';
    mobileMenu.style.pointerEvents = 'none';
    hamburger?.setAttribute('aria-expanded', 'false');
    (bars[0] as HTMLElement).style.transform = '';
    (bars[1] as HTMLElement).style.opacity   = '';
    (bars[2] as HTMLElement).style.transform = '';
    document.body.style.overflow = '';
  }

  hamburger?.addEventListener('click', () => isOpen ? closeMenu() : openMenu());
  document.querySelectorAll('.mobile-nav-link').forEach(l => l.addEventListener('click', closeMenu));
  document.addEventListener('click', (e) => {
    if (isOpen && !mobileMenu?.contains(e.target as Node) && !hamburger?.contains(e.target as Node)) closeMenu();
  });

  window.addEventListener('scroll', () => {
    document.getElementById('header-inner')?.classList.toggle('shadow-xl', window.scrollY > 30);
  });

</script>

<script is:inline>
  function toggleTheme() {
    var html = document.documentElement;
    var isDark = html.classList.contains('dark');
    html.classList.toggle('dark', !isDark);
    localStorage.setItem('theme', isDark ? 'light' : 'dark');
  }
</script>

<style>
  #main-header { transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1); }
  :global(body) { padding-top: 80px; }
  @media (max-width: 640px) { :global(body) { padding-top: 72px; } }
</style>
