---
const educations = [
  { school: "Telkom University", degree: "Bachelor of Information Systems", period: "Sep 2024 - Present", location: "Purwokerto, Indonesia", description: "Currently pursuing degree in Information Systems with focus on software engineering and technology innovation.", grade: "Current Student", icon: "fa-solid fa-graduation-cap", grad: "from-rose-500 to-violet-500",  leftBorder: "border-l-rose-500",   achievements: ["Active in HMSI organization","Participating in multiple committees","Developing technical skills in web development"] },
  { school: "SMK Telkom Sandhy Putra Malang", degree: "Software Engineering", period: "Jul 2021 - Jun 2024", location: "Malang, Indonesia", description: "Specialized in Software Engineering with comprehensive training in web development and UI/UX design.", grade: "Graduate", icon: "fa-solid fa-school", grad: "from-violet-500 to-teal-500", leftBorder: "border-l-violet-500", achievements: ["BNSP Certificate - Junior Graphic Designer (2022)","BNSP Certificate - Junior UI/UX Designer (2023)","MTA Certificate - Microsoft Technology Associate JavaScript (2023)","Certificate of Competency - Node & React JS (2023)"] },
  { school: "MTsN 1 Kediri", degree: "Junior High School", period: "Jul 2018 - Jul 2021", location: "Kediri, Indonesia", description: "Completed junior high school education with strong foundation in academics.", grade: "Graduate", icon: "fa-solid fa-book-open", grad: "from-teal-500 to-violet-500", leftBorder: "border-l-teal-500",   achievements: ["Strong academic performance","Active in school activities","Built foundation for technical education"] },
];
---

<section id="education" class="py-24 px-6 bg-white dark:bg-slate-900 relative overflow-hidden">
  <div class="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-violet-400/60 to-transparent"></div>

  <div class="container mx-auto max-w-5xl">
    <div class="text-center mb-16 animate-on-scroll">
      <div class="section-badge bg-violet-50 dark:bg-violet-500/20 border-violet-200 dark:border-violet-500/40 text-violet-600 dark:text-violet-300 mb-4 mx-auto" style="width:fit-content;">
        <i class="fa-solid fa-graduation-cap"></i> Education
      </div>
      <h2 class="text-4xl md:text-5xl font-black text-slate-900 dark:text-white mb-4">
        My <span class="bg-gradient-to-r from-violet-500 to-teal-500 text-transparent bg-clip-text">Education</span>
      </h2>
      <div class="w-20 h-1 bg-gradient-to-r from-violet-500 to-teal-500 mx-auto rounded-full"></div>
    </div>

    <div class="space-y-6">
      {educations.map((edu, i) => (
        <div class="group bg-slate-50 dark:bg-slate-800 rounded-2xl border-l-4 border border-slate-200 dark:border-slate-700 hover:border-slate-300 dark:hover:border-slate-600 transition-all duration-300 card-hover shimmer-hover animate-on-scroll" style={`transition-delay:${i*0.1}s; border-left-color: inherit;`}>
          <div class={`bg-slate-50 dark:bg-slate-800 rounded-2xl border-l-4 ${edu.leftBorder} p-7`}>
            <div class="flex flex-col md:flex-row gap-5">
              <div class="flex-shrink-0">
                <div class={`w-14 h-14 bg-gradient-to-br ${edu.grad} rounded-xl flex items-center justify-center shadow-md group-hover:rotate-6 transition-transform duration-300`}>
                  <i class={`${edu.icon} text-white text-2xl`}></i>
                </div>
              </div>
              <div class="flex-1">
                <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-2 mb-2">
                  <div>
                    <h3 class="text-lg font-bold text-slate-900 dark:text-white">{edu.school}</h3>
                    <p class="text-slate-600 dark:text-slate-300 font-medium text-sm">{edu.degree}</p>
                  </div>
                  <span class="self-start inline-flex items-center gap-1.5 px-3 py-1 bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-600 rounded-full text-xs font-semibold whitespace-nowrap">
                    <i class="fa-solid fa-calendar text-rose-500 text-xs"></i>
                    {edu.period}
                  </span>
                </div>
                <div class="flex items-center gap-1.5 text-slate-400 dark:text-slate-500 text-xs mb-3">
                  <i class="fa-solid fa-location-dot text-rose-500"></i>
                  {edu.location}
                </div>
                <p class="text-slate-500 dark:text-slate-400 text-sm mb-4 leading-relaxed">{edu.description}</p>
                <ul class="space-y-1.5">
                  {edu.achievements.map(a => (
                    <li class="flex items-start gap-2 text-xs text-slate-500 dark:text-slate-400">
                      <i class="fa-solid fa-check text-teal-500 mt-0.5 flex-shrink-0"></i>
                      {a}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
