<section id="about" class="py-24 px-6 bg-white dark:bg-slate-900 relative overflow-hidden">
  <div class="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-violet-400/60 to-transparent"></div>

  <div class="container mx-auto max-w-6xl">
    <div class="text-center mb-16 animate-on-scroll">
      <div class="section-badge bg-violet-50 dark:bg-violet-500/20 border-violet-200 dark:border-violet-500/40 text-violet-600 dark:text-violet-300 mb-4 mx-auto" style="width:fit-content;">
        <i class="fa-solid fa-user"></i> About Me
      </div>
      <h2 class="text-4xl md:text-5xl font-black text-slate-900 dark:text-white mb-4">
        Who <span class="bg-gradient-to-r from-violet-500 to-rose-500 text-transparent bg-clip-text">Am I?</span>
      </h2>
      <div class="w-20 h-1 bg-gradient-to-r from-violet-500 to-rose-500 mx-auto rounded-full"></div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">

      <!-- Bio card -->
      <div class="lg:col-span-2 bg-slate-50 dark:bg-slate-800 rounded-3xl p-8 border border-slate-200 dark:border-slate-700 hover:border-violet-300 dark:hover:border-violet-500/50 transition-all duration-300 card-hover animate-on-scroll">
        <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-4 flex items-center gap-2">
          <span class="w-8 h-8 bg-gradient-to-br from-violet-500 to-rose-500 rounded-lg flex items-center justify-center">
            <i class="fa-solid fa-pen-nib text-white text-xs"></i>
          </span>
          My Story
        </h3>
        <p class="text-slate-700 dark:text-slate-300 leading-relaxed mb-4">
          I'm an <span class="text-violet-600 dark:text-violet-400 font-semibold">Information Systems student</span> with strong interpersonal skills and active experience in organizations and internships. I've developed communication, teamwork, leadership, and problem-solving abilities.
        </p>
        <p class="text-slate-500 dark:text-slate-400 leading-relaxed text-sm">
          With a deep interest in research and IT, I have software engineering experience using Java, PHP, HTML, CSS, Laravel, Node.js, and React. Always eager to learn new technologies and quickly adapt to changes.
        </p>
        <div class="mt-5 flex items-center gap-2 text-slate-400 dark:text-slate-500 text-sm">
          <i class="fa-solid fa-location-dot text-rose-500"></i>
          Kediri, East Java, Indonesia
        </div>
      </div>

      <!-- Quick facts -->
      <div class="bg-slate-50 dark:bg-slate-800 rounded-3xl p-6 border border-slate-200 dark:border-slate-700 hover:border-rose-300 dark:hover:border-rose-500/50 transition-all duration-300 card-hover animate-on-scroll" style="transition-delay:0.1s">
        <div class="flex items-center gap-2 mb-5">
          <i class="fa-solid fa-list-check text-rose-500"></i>
          <h3 class="text-base font-bold text-slate-900 dark:text-white">Quick Facts</h3>
        </div>
        <ul class="space-y-3">
          {[
            ['fa-solid fa-graduation-cap','from-violet-500 to-rose-500','Information Systems @ Telkom'],
            ['fa-solid fa-briefcase','from-rose-500 to-violet-500','Junior Web Developer'],
            ['fa-solid fa-star','from-teal-500 to-violet-500','Head of Dept. at HIPMI'],
            ['fa-solid fa-envelope','from-slate-400 to-slate-500','putryazaila1306@gmail.com'],
          ].map(([icon, grad, text]) => (
            <li class="flex items-start gap-3">
              <span class={`w-7 h-7 bg-gradient-to-br ${grad} rounded-lg flex items-center justify-center flex-shrink-0 mt-0.5`}>
                <i class={`${icon} text-white text-xs`}></i>
              </span>
              <span class="text-slate-600 dark:text-slate-300 text-xs leading-relaxed pt-1">{text}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Trait cards -->
      {[
        ['fa-solid fa-lightbulb',  'from-rose-500 to-orange-400',  'Problem Solver',     'Enjoy tackling complex challenges and finding elegant solutions through innovative thinking.'],
        ['fa-solid fa-book-open',  'from-violet-500 to-rose-500',  'Continuous Learner', 'Always exploring new tech and staying updated with industry trends and best practices.'],
        ['fa-solid fa-users',      'from-teal-500 to-violet-500',  'Team Player',        'Collaborative mindset with strong communication skills and proven leadership experience.'],
      ].map(([icon, grad, title, desc], i) => (
        <div class="group bg-slate-50 dark:bg-slate-800 rounded-2xl p-6 border border-slate-200 dark:border-slate-700 hover:scale-[1.02] transition-all duration-300 card-hover animate-on-scroll" style={`transition-delay:${(i+2)*0.1}s`}>
          <div class={`w-11 h-11 bg-gradient-to-br ${grad} rounded-xl flex items-center justify-center mb-4 shadow-md group-hover:rotate-6 transition-transform duration-300`}>
            <i class={`${icon} text-white text-lg`}></i>
          </div>
          <h4 class="text-sm font-bold text-slate-900 dark:text-white mb-2">{title}</h4>
          <p class="text-slate-500 dark:text-slate-400 text-xs leading-relaxed">{desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
