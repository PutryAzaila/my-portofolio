---
const experiences = [
  {
    title: "Head of Department - Research & IT",
    company: "HIPMI (Indonesian Young Entrepreneurs Association)",
    type: "Organization", period: "Jan 2026 - Present", location: "Purwokerto, Indonesia",
    description: "Leading the Research & IT Department at HIPMI, overseeing department strategy, team coordination, and digital initiatives.",
    technologies: ["Leadership", "React", "HTML", "CSS", "Web Design"],
    icon: "fa-solid fa-star", grad: "from-rose-500 to-orange-400",
    leftBorder: "border-l-rose-500",
    badge: "bg-rose-50 dark:bg-rose-500/20 text-rose-600 dark:text-rose-300 border-rose-200 dark:border-rose-500/40",
    pill: "bg-rose-50 dark:bg-rose-500/15 text-rose-600 dark:text-rose-300",
    highlights: ["Led department strategy and digital initiatives","Coordinated team of research and IT members","Oversaw department programs and deliverables"],
  },
  {
    title: "Staff - Research & IT Department",
    company: "HIPMI (Indonesian Young Entrepreneurs Association)",
    type: "Organization", period: "Jan 2025 - Jan 2026", location: "Purwokerto, Indonesia",
    description: "Creating HIPMI landing page website and managing IT infrastructure while participating in video profile creation as Public Relations.",
    technologies: ["React", "HTML", "CSS", "Web Design"],
    icon: "fa-solid fa-rocket", grad: "from-violet-500 to-rose-500",
    leftBorder: "border-l-violet-500",
    badge: "bg-violet-50 dark:bg-violet-500/20 text-violet-600 dark:text-violet-300 border-violet-200 dark:border-violet-500/40",
    pill: "bg-violet-50 dark:bg-violet-500/15 text-violet-600 dark:text-violet-300",
    highlights: ["Developed HIPMI landing page website","Participated in video profile creation","Managed department communications"],
  },
  {
    title: "Intern - Human Resource Development",
    company: "HMSI (Information Systems Student Association)",
    type: "Internship", period: "Apr 2025 - Okt 2025", location: "Purwokerto, Indonesia",
    description: "Active in multiple committees including Student Achievement (Secretary), Sports Week (Event Division), and International Guest Lecture (PR).",
    technologies: ["Event Management", "Communication", "Documentation"],
    icon: "fa-solid fa-bullseye", grad: "from-teal-500 to-cyan-500",
    leftBorder: "border-l-teal-500",
    badge: "bg-teal-50 dark:bg-teal-500/20 text-teal-700 dark:text-teal-300 border-teal-200 dark:border-teal-500/40",
    pill: "bg-teal-50 dark:bg-teal-500/15 text-teal-700 dark:text-teal-300",
    highlights: ["Secretary for Student Achievement Committee","Event Division for Sports Week","PR for International Guest Lecture"],
  },
  {
    title: "Intern",
    company: "Telkom Landmark Surabaya",
    type: "Internship", period: "Nov 2023 - Apr 2024", location: "Surabaya, Indonesia",
    description: "Developed attendance website using Node.js and enhanced web applications using Laravel and React.",
    technologies: ["Node.js", "Laravel", "React", "MySQL"],
    icon: "fa-solid fa-briefcase", grad: "from-violet-500 to-teal-500",
    leftBorder: "border-l-violet-500",
    badge: "bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 border-slate-200 dark:border-slate-600",
    pill: "bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300",
    highlights: ["Built attendance system with camera and location features","Collaborated with 4 team members on project delivery","Developed and integrated multiple websites"],
  },
];
---

<section id="experience" class="py-24 px-6 bg-white dark:bg-slate-900 relative overflow-hidden">
  <div class="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-rose-400/60 to-transparent"></div>

  <div class="container mx-auto max-w-5xl">
    <div class="text-center mb-16 animate-on-scroll">
      <div class="section-badge bg-rose-50 dark:bg-rose-500/20 border-rose-200 dark:border-rose-500/40 text-rose-600 dark:text-rose-300 mb-4 mx-auto" style="width:fit-content;">
        <i class="fa-solid fa-briefcase"></i> Experience
      </div>
      <h2 class="text-4xl md:text-5xl font-black text-slate-900 dark:text-white mb-4">
        Work &amp; <span class="bg-gradient-to-r from-rose-500 to-violet-500 text-transparent bg-clip-text">Journey</span>
      </h2>
      <div class="w-20 h-1 bg-gradient-to-r from-rose-500 to-violet-500 mx-auto rounded-full"></div>
    </div>

    <div class="relative">
      <div class="absolute left-5 md:left-8 top-2 bottom-2 w-0.5 bg-gradient-to-b from-rose-400 via-violet-400 to-teal-400 opacity-40 hidden md:block"></div>

      <div class="space-y-8">
        {experiences.map((exp, i) => (
          <div class="relative flex gap-6 md:gap-10 animate-on-scroll" style={`transition-delay:${i*0.1}s`}>
            <div class="hidden md:flex flex-col items-center flex-shrink-0 mt-7">
              <div class={`w-5 h-5 rounded-full bg-gradient-to-br ${exp.grad} ring-4 ring-white dark:ring-slate-900 z-10`}></div>
            </div>

            <div class={`flex-1 group bg-slate-50 dark:bg-slate-800 rounded-2xl border-l-4 ${exp.leftBorder} border border-slate-200 dark:border-slate-700 hover:border-slate-300 dark:hover:border-slate-600 transition-all duration-300 card-hover overflow-hidden`}>
              <div class="p-6 md:p-7">
                <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3 mb-4">
                  <div class="flex items-center gap-3">
                    <div class={`w-11 h-11 bg-gradient-to-br ${exp.grad} rounded-xl flex items-center justify-center flex-shrink-0 group-hover:rotate-6 transition-transform duration-300 shadow-md`}>
                      <i class={`${exp.icon} text-white`}></i>
                    </div>
                    <div>
                      <h3 class="text-base font-bold text-slate-900 dark:text-white leading-tight">{exp.title}</h3>
                      <p class="text-xs text-slate-500 dark:text-slate-400 font-medium">{exp.company}</p>
                    </div>
                  </div>
                  <span class={`self-start px-3 py-1 ${exp.badge} border rounded-full text-xs font-semibold`}>{exp.type}</span>
                </div>

                <div class="flex flex-wrap gap-x-5 gap-y-1 text-slate-400 dark:text-slate-500 text-xs mb-3">
                  <span class="flex items-center gap-1.5"><i class="fa-solid fa-calendar"></i> {exp.period}</span>
                  <span class="flex items-center gap-1.5"><i class="fa-solid fa-location-dot"></i> {exp.location}</span>
                </div>

                <p class="text-slate-600 dark:text-slate-300 text-sm mb-4 leading-relaxed">{exp.description}</p>

                <ul class="space-y-1.5 mb-4">
                  {exp.highlights.map(h => (
                    <li class="flex items-start gap-2 text-xs text-slate-500 dark:text-slate-400">
                      <i class="fa-solid fa-check text-teal-500 mt-0.5 flex-shrink-0"></i>
                      {h}
                    </li>
                  ))}
                </ul>

                <div class="flex flex-wrap gap-1.5">
                  {exp.technologies.map(tech => (
                    <span class={`px-2.5 py-1 ${exp.pill} rounded-full text-xs font-medium`}>{tech}</span>
                  ))}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
