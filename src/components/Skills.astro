---
const cats = [
  {
    title: "Frontend",
    icon: "fa-solid fa-code",
    grad: "from-rose-500 to-violet-500",
    pill: "bg-rose-50 dark:bg-rose-500/20 border-rose-200 dark:border-rose-500/40 text-rose-600 dark:text-rose-300",
    skills: ["HTML", "CSS", "JavaScript", "React", "Tailwind CSS", "Astro", "Bootstrap"],
  },
  {
    title: "Backend",
    icon: "fa-solid fa-server",
    grad: "from-violet-500 to-indigo-500",
    pill: "bg-violet-50 dark:bg-violet-500/20 border-violet-200 dark:border-violet-500/40 text-violet-600 dark:text-violet-300",
    skills: ["Node.js", "PHP", "Laravel", "MySQL", "Java"],
  },
  {
    title: "ML & Data",
    icon: "fa-solid fa-brain",
    grad: "from-teal-500 to-cyan-500",
    pill: "bg-teal-50 dark:bg-teal-500/20 border-teal-200 dark:border-teal-500/40 text-teal-700 dark:text-teal-300",
    skills: ["Python", "ML Fundamentals", "Data Analysis"],
  },
  {
    title: "Tools & Design",
    icon: "fa-solid fa-toolbox",
    grad: "from-slate-500 to-violet-500",
    pill: "bg-slate-100 dark:bg-slate-700 border-slate-200 dark:border-slate-600 text-slate-600 dark:text-slate-300",
    skills: ["Git & GitHub", "Figma", "Canva", "VS Code", "Blender"],
  },
];
---

<section id="skills" class="py-24 px-6 bg-slate-50 dark:bg-slate-950 relative overflow-hidden">
  <div class="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-teal-400/60 to-transparent"></div>

  <div class="container mx-auto max-w-6xl relative">
    <div class="text-center mb-16 animate-on-scroll">
      <div class="section-badge bg-teal-50 dark:bg-teal-500/20 border-teal-200 dark:border-teal-500/40 text-teal-700 dark:text-teal-300 mb-4 mx-auto" style="width:fit-content;">
        <i class="fa-solid fa-code"></i> Tech Stack
      </div>
      <h2 class="text-4xl md:text-5xl font-black text-slate-900 dark:text-white mb-4">
        Skills &amp; <span class="bg-gradient-to-r from-teal-500 to-violet-500 text-transparent bg-clip-text">Technologies</span>
      </h2>
      <div class="w-20 h-1 bg-gradient-to-r from-teal-500 to-violet-500 mx-auto rounded-full"></div>
      <p class="text-slate-500 dark:text-slate-400 mt-4 text-sm">Technologies and tools I love working with</p>
    </div>

    <div class="grid sm:grid-cols-2 gap-6">
      {cats.map((cat, i) => (
        <div class="group bg-white dark:bg-slate-800 rounded-3xl p-7 border border-slate-200 dark:border-slate-700 hover:border-slate-300 dark:hover:border-slate-600 transition-all duration-300 card-hover shimmer-hover animate-on-scroll" style={`transition-delay:${i*0.1}s`}>
          <div class="flex items-center gap-4 mb-6">
            <div class={`w-12 h-12 bg-gradient-to-br ${cat.grad} rounded-2xl flex items-center justify-center shadow-md group-hover:scale-110 group-hover:rotate-6 transition-all duration-300`}>
              <i class={`${cat.icon} text-white text-xl`}></i>
            </div>
            <h3 class="text-lg font-bold text-slate-900 dark:text-white">{cat.title}</h3>
          </div>
          <div class="flex flex-wrap gap-2">
            {cat.skills.map(skill => (
              <span class={`px-3 py-1.5 ${cat.pill} border rounded-full text-xs font-semibold hover:scale-105 transition-transform duration-200 cursor-default`}>
                {skill}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>

    <div class="text-center mt-10 animate-on-scroll">
      <span class="inline-flex items-center gap-2 px-5 py-2.5 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-full text-slate-500 dark:text-slate-400 text-sm">
        <span class="w-2 h-2 bg-teal-500 rounded-full animate-pulse"></span>
        Always learning &amp; exploring new technologies
      </span>
    </div>
  </div>
</section>
